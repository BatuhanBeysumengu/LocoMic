<Window x:Class="EqualizerHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EqualizerHelper.App"
        xmlns:converters="clr-namespace:EqualizerHelper.App.Converters"
        xmlns:controls="clr-namespace:EqualizerHelper.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Equalizer Helper" Height="840" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStyle="None"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ToolTipService.InitialShowDelay="350"
        ToolTipService.ShowDuration="20000"
        Closed="MainWindow_OnClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                             GlassFrameThickness="0" CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Small all-caps heading above a card, as in the original layout. -->
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <!-- Subtle heading for a group of controls inside a card. -->
        <Style x:Key="GroupHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ControlLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />

        <!-- Small square icon button (play/stop, remove). -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon that lights up when on (used for Loop). Content is the icon glyph. -->
        <Style x:Key="IconToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Width="26" Height="26">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- One slider row: label | slider | value. -->
        <Style x:Key="SliderRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: menu, app name, window buttons -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="MenuButton" Grid.Column="0" Style="{StaticResource CaptionButtonStyle}" Width="48" Click="MenuButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Menu: switch between Home and Settings">
                <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="ShowHome_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Width="26" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Click="ShowSettings_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Width="26" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Rectangle Width="4" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="15" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="11" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="18" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="Equalizer Helper" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="PageNameText" Text="" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize to the system tray">
                    <Rectangle Width="10" Height="1"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestore_Click" ToolTip="Maximize / restore">
                    <Rectangle Width="10" Height="10"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click"
                        ToolTip="Close the window (the app keeps running in the system tray; right-click the tray icon to exit)">
                    <Path Data="M0,0 L10,10 M0,10 L10,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="PagesHost" Grid.Row="1">

            <!-- HOME -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18,24,18" MaxWidth="1400">

                    <TextBlock Text="CONTROLS" Style="{StaticResource EyebrowStyle}" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Transport + presets -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Padding="22,9" Command="{Binding ToggleStartStopCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Content" Value="Start" />
                                            <Setter Property="ToolTip" Value="Start processing your mic and sending it to the output device" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Content" Value="Stop" />
                                                    <Setter Property="ToolTip" Value="Stop processing your mic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <CheckBox Grid.Column="1" Content="Bypass" Margin="18,0,0,0" IsChecked="{Binding Bypass}"
                                          ToolTip="Skip all processing so you can compare with your original mic sound (Ctrl+Alt+B)" />
                                <CheckBox Grid.Column="2" Content="Mute" Margin="14,0,0,0" IsChecked="{Binding IsMuted}"
                                          ToolTip="Silence your mic for everyone (Ctrl+Alt+M)" />

                                <Button Grid.Column="3" Padding="14,8" Margin="18,0,0,0" Command="{Binding ToggleAutoTuneCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Auto-Tune Voice" />
                                            <Setter Property="ToolTip" Value="Talk for a few seconds and the equalizer tunes itself. Start the mic first; afterwards click Keep or Revert at the bottom." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoTuning}" Value="True">
                                                    <Setter Property="Content" Value="Cancel Auto-Tune" />
                                                    <Setter Property="ToolTip" Value="Stop auto-tuning and go back to your previous settings" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Grid.Column="5" Text="Preset:" Style="{StaticResource SectionLabelStyle}" />
                                <ComboBox Grid.Column="6" Width="200" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          ToolTip="Pick a saved sound. Choose '+ New preset...' to create your own from the current settings." />
                                <Button Grid.Column="7" Content="Save" Padding="14,8" Margin="8,0,0,0"
                                        Command="{Binding SavePresetCommand}"
                                        ToolTip="Save all current settings into the selected preset" />
                                <Button Grid.Column="8" Content="{Binding DeleteButtonText}" Padding="14,8" Margin="8,0,0,0"
                                        Command="{Binding DeletePresetCommand}"
                                        ToolTip="Delete your own preset, or reset a built-in preset you changed back to its original settings" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,18,0,16" />

                            <!-- Sound controls, three columns -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Clean-up -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CLEAN-UP" Style="{StaticResource GroupHeadingStyle}" />

                                    <Grid Style="{StaticResource SliderRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="AI noise removal" IsChecked="{Binding NoiseRemoval}"
                                                  ToolTip="Removes background noise (fans, keyboard, traffic, hum) even while you talk. Uses the RNNoise neural network on your CPU." />
                                        <Slider Grid.Column="2" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                Value="{Binding NoiseRemovalStrength}" VerticalAlignment="Center" IsEnabled="{Binding NoiseRemoval}"
                                                ToolTip="Noise removal strength. Lower it if your voice sounds robotic or underwater." />
                                        <TextBlock Grid.Column="3" Style="{StaticResource ValueTextStyle}" IsEnabled="{Binding NoiseRemoval}"
                                                   Text="{Binding NoiseRemovalStrength, StringFormat={}{0:P0}}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gain" Style="{StaticResource ControlLabelStyle}" />
                                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="-12" Maximum="24"
                                                Value="{Binding InputGainDb}" VerticalAlignment="Center"
                                                ToolTip="Makes your mic louder or quieter before anything else. Raise it if the Input meter barely moves." />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding InputGainDb, StringFormat={}{0:+0;-0;0} dB}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gate" Style="{StaticResource ControlLabelStyle}" />
                                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                Value="{Binding Gate}" VerticalAlignment="Center"
                                                ToolTip="Turns your mic down when you're not talking, hiding keyboard, fan and room noise. Raise it until noise disappears between words; too high cuts off quiet words." />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding GateDisplay}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRowStyle}" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Loudness" Style="{StaticResource ControlLabelStyle}" />
                                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                Value="{Binding Loudness}" VerticalAlignment="Center"
                                                ToolTip="Evens out your volume and makes your voice fuller and louder. A built-in limiter always stops the output from clipping." />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding Loudness, StringFormat={}{0:P0}}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Voice + monitoring -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VOICE" Style="{StaticResource GroupHeadingStyle}" />

                                    <Grid Style="{StaticResource SliderRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pitch" Style="{StaticResource ControlLabelStyle}" />
                                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="-12" Maximum="12"
                                                Value="{Binding PitchSemitones}" VerticalAlignment="Center"
                                                ToolTip="Make your voice deeper (left) or higher (right). 0 = your normal voice, 12 = one octave." />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding PitchSemitones, StringFormat={}{0:+0;-0;0} st}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Crunch" Style="{StaticResource ControlLabelStyle}" />
                                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                Value="{Binding MicCrunch}" VerticalAlignment="Center"
                                                ToolTip="Adds a cheap, overdriven 'bad mic' sound (distortion + heavy compression). 0% = clean." />
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding MicCrunch, StringFormat={}{0:P0}}" />
                                    </Grid>

                                    <TextBlock Text="LISTEN" Style="{StaticResource GroupHeadingStyle}" Margin="0,6,0,10" />
                                    <CheckBox Content="Hear yourself through:" IsChecked="{Binding MonitorEnabled}"
                                              ToolTip="Play your processed voice in your headphones so you can hear your changes" />
                                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedMonitorDevice}"
                                              IsEnabled="{Binding MonitorEnabled}"
                                              ToolTip="Headphones to hear yourself on (use headphones, not speakers, to avoid echo)" />
                                </StackPanel>

                                <!-- Soundboard -->
                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SOUNDS" Style="{StaticResource GroupHeadingStyle}" />
                                        <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}" Content="Stop all" Margin="0,-6,6,0"
                                                Command="{Binding StopAllSoundsCommand}"
                                                ToolTip="Stop every sound that's playing" />
                                        <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}" Content="+ Add" Margin="0,-6,0,0"
                                                Command="{Binding AddSoundsCommand}"
                                                ToolTip="Add songs or sound effects (MP3, WAV, M4A, WMA, FLAC...) to play into your mic" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{StaticResource ControlBackgroundBrush}" CornerRadius="8" Height="116" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="Add songs or sound effects with '+ Add', then press ▶ (or numpad 1–9) to play them into your mic while you talk."
                                                       Style="{StaticResource HelpTextStyle}" Margin="12,0" VerticalAlignment="Center" TextAlignment="Center">
                                                <TextBlock.Visibility>
                                                    <Binding Path="Sounds.Count" Converter="{StaticResource ZeroToVisibleConverter}" />
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                                <ItemsControl ItemsSource="{Binding Sounds}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="11" VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                                                           ToolTip="Hotkey number: while started, press this key on the numpad to play/stop the sound (changeable in Settings)" />
                                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                                        Command="{Binding DataContext.ToggleSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="&#xE768;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                        <Setter Property="Text" Value="&#xE71A;" />
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button.ToolTip>
                                                                        <TextBlock>
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="Play this sound into your mic" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                            <Setter Property="Text" Value="Stop this sound" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Button.ToolTip>
                                                                </Button>

                                                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0,8,0"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <Slider Grid.Column="3" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                                        Value="{Binding Volume}" VerticalAlignment="Center"
                                                                        ToolTip="Volume of this sound" />

                                                                <CheckBox Grid.Column="4" Style="{StaticResource IconToggleStyle}" Content="&#xE8EE;" Margin="6,0,0,0"
                                                                          IsChecked="{Binding Loop}"
                                                                          ToolTip="Loop: play this sound over and over (good for background music)" />

                                                                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                                                        Command="{Binding DataContext.RemoveSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remove from the list (the file itself is not deleted)">
                                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2">
                                        <Grid Style="{StaticResource SliderRowStyle}" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Volume" Style="{StaticResource ControlLabelStyle}" />
                                            <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                                    Value="{Binding SoundVolume}" VerticalAlignment="Center"
                                                    ToolTip="Volume of all sounds compared to your voice" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource ValueTextStyle}" Text="{Binding SoundVolume, StringFormat={}{0:P0}}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Lower while I talk" IsChecked="{Binding DuckSounds}"
                                                      ToolTip="Automatically turns sounds down while you're talking so people can understand you, and back up when you stop" />
                                            <CheckBox Content="Hear sounds" Margin="16,0,0,0" IsChecked="{Binding HearSounds}"
                                                      ToolTip="Also play the sounds in your headphones (needs 'Hear yourself' on)" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="EQUALIZER" Style="{StaticResource EyebrowStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2" />
                                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Text="{Binding FrequencyHz, StringFormat={}{0:0} Hz}" />

                                        <Slider Orientation="Vertical" Height="180" Minimum="-15" Maximum="15"
                                                Value="{Binding GainDb}" HorizontalAlignment="Center"
                                                ToolTip="Boost (up) or cut (down) this part of your voice" />

                                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,10" Foreground="{StaticResource AccentBrush}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"
                                                    ToolTip="Width of the band: lower = wider and gentler, higher = narrower and more precise">
                                            <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Q, StringFormat=0.00}" Width="58" />
                                        </StackPanel>

                                        <CheckBox Content="On" IsChecked="{Binding Enabled}" HorizontalAlignment="Center"
                                                  ToolTip="Turn this band on or off" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS -->
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,18,24,18" MaxWidth="1400">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                        <Button Grid.Column="1" Content="Back to Home" VerticalAlignment="Center" Click="ShowHome_Click"
                                ToolTip="Go back to the main screen" />
                    </Grid>
                    <TextBlock Text="Devices, shortcuts, startup and preset files." Style="{StaticResource PageSubtitleStyle}" />

                    <controls:ResponsiveColumnsPanel TwoColumnMinWidth="880">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Devices" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                                            ToolTip="Look again for microphones and speakers (use after plugging something in)" />
                                </Grid>

                                <TextBlock Text="Microphone" Style="{StaticResource ControlLabelStyle}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding SelectedCaptureDevice}"
                                          ToolTip="Your real microphone" />

                                <TextBlock Text="Output" Style="{StaticResource ControlLabelStyle}" Margin="0,14,0,6" />
                                <ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedRenderDevice}"
                                          ToolTip="Where the processed voice goes. Pick 'CABLE Input (VB-Audio Virtual Cable)'." />
                                <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0"
                                           Text="Then choose 'CABLE Output' as your microphone in Discord, OBS or Zoom." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hotkeys" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Change..." Command="{Binding EditHotkeysCommand}"
                                            ToolTip="Change the keyboard shortcuts. They work everywhere, even in games." />
                                </Grid>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,10,0,0" Text="{Binding HotkeySummary}" />
                                <CheckBox Content="Numpad plays sounds (1–9 play/stop, 0 stops all)" Margin="0,12,0,0" IsChecked="{Binding SoundHotkeysEnabled}"
                                          ToolTip="While the app is started, numpad keys play the sounds in your list. They're released when you press Stop, so the numpad types normally again." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" FontSize="14"
                                          ToolTip="Open Equalizer Helper automatically when you sign in to Windows" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Preset files" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,4,0,12"
                                           Text="Share presets as .eqpreset files, or add presets someone sent you." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Import..." Command="{Binding ImportPresetsCommand}"
                                            ToolTip="Add presets from .eqpreset files. Existing presets are never overwritten." />
                                    <Button Content="Export current..." Margin="8,0,0,0" Command="{Binding ExportPresetCommand}"
                                            ToolTip="Save the current settings to a .eqpreset file you can share" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:ResponsiveColumnsPanel>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Status strip: meters, messages, auto-tune Keep/Revert -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Input" Style="{StaticResource SectionLabelStyle}"
                           ToolTip="Your mic level. If it barely moves when you talk, raise Gain." />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding InputLevel}" Height="8" VerticalAlignment="Center"
                             ToolTip="Your mic level. If it barely moves when you talk, raise Gain." />
                <TextBlock Grid.Column="2" Text="Output" Style="{StaticResource SectionLabelStyle}" Margin="16,0,8,0"
                           ToolTip="The processed level going to your output device (what Discord/OBS hear)" />
                <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding OutputLevel}" Height="8" VerticalAlignment="Center"
                             ToolTip="The processed level going to your output device (what Discord/OBS hear)" />

                <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,12,0" />

                <Button Grid.Column="5" Content="Get VB-Audio Virtual Cable"
                        Command="{Binding OpenVirtualCableDownloadPageCommand}"
                        Visibility="{Binding VirtualCableDetected, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        ToolTip="Open the free VB-Audio Virtual Cable download page. It lets other apps use your processed mic." />

                <Button Grid.Column="6" Content="Keep" Margin="8,0,0,0"
                        Command="{Binding KeepAutoTuneCommand}"
                        Visibility="{Binding CanRevertAutoTune, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Keep the auto-tuned equalizer (you can also save it as a preset)" />

                <Button Grid.Column="7" Content="Revert" Margin="8,0,0,0"
                        Command="{Binding RevertAutoTuneCommand}"
                        Visibility="{Binding CanRevertAutoTune, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Undo the auto-tune and go back to your previous equalizer" />
            </Grid>
        </Border>
    </Grid>
</Window>
