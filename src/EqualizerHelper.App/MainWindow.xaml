<Window x:Class="EqualizerHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EqualizerHelper.App"
        xmlns:converters="clr-namespace:EqualizerHelper.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Equalizer Helper" Height="800" Width="1040"
        MinHeight="720" MinWidth="900"
        WindowStyle="None"
        Closed="MainWindow_OnClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                             GlassFrameThickness="0" CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Rectangle Width="4" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="15" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="11" Fill="{StaticResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="18" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="Equalizer Helper" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click">
                    <Rectangle Width="10" Height="1"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestore_Click">
                    <Rectangle Width="10" Height="10"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click">
                    <Path Data="M0,0 L10,10 M0,10 L10,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="24,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DEVICES" Style="{StaticResource EyebrowStyle}" />

            <!-- Controls card: devices, monitor, transport -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Device selection -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Microphone:" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedCaptureDevice}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3" Text="Output:" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedRenderDevice}" VerticalAlignment="Center" />

                        <Button Grid.Column="5" Content="Refresh" Margin="12,0,0,0"
                                Command="{Binding RefreshDevicesCommand}" />
                    </Grid>

                    <!-- Monitor (hear yourself) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Content="Hear yourself while tuning, via:" VerticalAlignment="Center"
                                  IsChecked="{Binding MonitorEnabled}" />
                        <ComboBox Grid.Column="1" Width="260" Margin="8,0,0,0" ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedMonitorDevice}" VerticalAlignment="Center" />

                        <CheckBox Grid.Column="2" Content="Start with Windows" VerticalAlignment="Center"
                                  HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}" />
                    </Grid>

                    <!-- Transport + presets -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Padding="20,9" Command="{Binding ToggleStartStopCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="Start" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <CheckBox Grid.Column="1" Content="Bypass" VerticalAlignment="Center" Margin="16,0,0,0"
                                  IsChecked="{Binding Bypass}" />

                        <Button Grid.Column="2" Padding="14,8" Margin="16,0,0,0" Command="{Binding ToggleAutoTuneCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Auto-Tune Voice" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoTuning}" Value="True">
                                            <Setter Property="Content" Value="Cancel Auto-Tune" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Grid.Column="4" Text="Preset:" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox Grid.Column="5" Width="180" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" />
                        <Button Grid.Column="6" Content="Save" Padding="12,8" Margin="8,0,0,0"
                                Command="{Binding SavePresetCommand}"
                                ToolTip="Save the current EQ, pitch and crunch into the selected preset" />
                        <Button Grid.Column="7" Content="{Binding DeleteButtonText}" Padding="12,8" Margin="8,0,0,0"
                                Command="{Binding DeletePresetCommand}"
                                ToolTip="Delete your preset, or reset an edited built-in preset to its original settings" />
                    </Grid>

                    <!-- Pitch (fun voice effect) -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Pitch:" Style="{StaticResource SectionLabelStyle}" />
                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="-12" Maximum="12"
                                Value="{Binding PitchSemitones}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Width="70">
                            <Run Text="{Binding PitchSemitones, StringFormat={}{0:+0;-0;0} st}" />
                        </TextBlock>
                    </Grid>

                    <!-- Mic Crunch (distortion + compression, fun voice effect) -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Mic Crunch:" Style="{StaticResource SectionLabelStyle}" />
                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                Value="{Binding MicCrunch}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Width="70">
                            <Run Text="{Binding MicCrunch, StringFormat={}{0:P0}}" />
                        </TextBlock>
                    </Grid>

                    <!-- Dynamics: input gain, noise gate, loudness (compressor + safety limiter) -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource SectionLabelStyle}"
                                   ToolTip="Boosts or lowers the mic before any processing" />
                        <Slider Grid.Column="1" Style="{StaticResource HorizontalSliderStyle}" Minimum="-12" Maximum="24"
                                Value="{Binding InputGainDb}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding InputGainDb, StringFormat={}{0:+0;-0;0} dB}" />
                        </TextBlock>

                        <TextBlock Grid.Column="4" Text="Gate:" Style="{StaticResource SectionLabelStyle}"
                                   ToolTip="Turns the mic down when you're not talking (hides keyboard, fan and room noise). Raise it until the noise disappears between words." />
                        <Slider Grid.Column="5" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                Value="{Binding Gate}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Text="{Binding GateDisplay}" />

                        <TextBlock Grid.Column="8" Text="Loudness:" Style="{StaticResource SectionLabelStyle}"
                                   ToolTip="Evens out your volume and makes your voice fuller and louder. A limiter always stops the output from clipping." />
                        <Slider Grid.Column="9" Style="{StaticResource HorizontalSliderStyle}" Minimum="0" Maximum="1"
                                Value="{Binding Loudness}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="10" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding Loudness, StringFormat={}{0:P0}}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="EQUALIZER" Style="{StaticResource EyebrowStyle}" />

            <!-- EQ bands -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <ItemsControl ItemsSource="{Binding Bands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="20,0" Width="120" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11">
                                    <Run Text="{Binding FrequencyHz, StringFormat={}{0:0} Hz}" />
                                </TextBlock>

                                <Slider Orientation="Vertical" Height="220" Minimum="-15" Maximum="15"
                                        Value="{Binding GainDb}" HorizontalAlignment="Center" />

                                <TextBlock Text="{Binding GainDb, StringFormat={}{0:0.0} dB}"
                                           HorizontalAlignment="Center" Margin="0,12,0,12" Foreground="{StaticResource AccentBrush}" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="Q" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding Q, StringFormat=0.00}" Width="48" />
                                </StackPanel>

                                <CheckBox Content="On" IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Grid.Row="4" Text="STATUS" Style="{StaticResource EyebrowStyle}" />

            <!-- Status card: meters, status text, auto-tune/VB-Cable actions -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Input" Style="{StaticResource SectionLabelStyle}" />
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding InputLevel}" Height="10" />

                        <TextBlock Grid.Column="3" Text="Output" Style="{StaticResource SectionLabelStyle}" />
                        <ProgressBar Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding OutputLevel}" Height="10" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <Button Grid.Column="1" Content="Get VB-Audio Virtual Cable"
                                Command="{Binding OpenVirtualCableDownloadPageCommand}"
                                Visibility="{Binding VirtualCableDetected, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <Button Grid.Column="2" Content="Keep" Margin="8,0,0,0"
                                Command="{Binding KeepAutoTuneCommand}"
                                Visibility="{Binding CanRevertAutoTune, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Grid.Column="3" Content="Revert" Margin="8,0,0,0"
                                Command="{Binding RevertAutoTuneCommand}"
                                Visibility="{Binding CanRevertAutoTune, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
