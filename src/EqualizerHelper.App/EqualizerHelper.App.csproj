<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EqualizerHelper.Dsp\EqualizerHelper.Dsp.csproj" />
    <ProjectReference Include="..\EqualizerHelper.Audio\EqualizerHelper.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>LocoMic</AssemblyName>
    <Product>LocoMic</Product>
    <AssemblyTitle>LocoMic</AssemblyTitle>
    <Version>1.0.1</Version>
    <Authors>Batuhan Beysümengü</Authors>
    <Company>Batuhan Beysümengü</Company>
    <Copyright>Copyright (C) 2026 Batuhan Beysümengü</Copyright>
  </PropertyGroup>

  <!-- Ship the license and third-party notices next to the published exe. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
