<Window x:Class="EqualizerHelper.App.Views.NamePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Preset" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Style="{StaticResource DialogWindowStyle}"
        Icon="pack://application:,,,/EqualizerHelper;component/Assets/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptTextBlock" Text="Name this preset so you can pick it again later:"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" x:Name="NameTextBox" />
        <TextBlock Grid.Row="2" x:Name="ErrorTextBlock" Foreground="IndianRed" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Don't Save" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="80" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
