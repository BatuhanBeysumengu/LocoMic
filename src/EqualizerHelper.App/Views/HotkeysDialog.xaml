<Window x:Class="EqualizerHelper.App.Views.HotkeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkeys" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Style="{StaticResource DialogWindowStyle}">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="These work anywhere in Windows, even while you're in a game or the app is in the tray. Click a box and press the keys you want (Ctrl, Alt, Shift or Win plus a key; numpad keys and the side mouse buttons Mouse4/Mouse5 can be used on their own). Keys still reach your game too. Sound keys only work while the app is started." />

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="RowsGrid" Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="PresetNumbersText" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75" />

        <TextBlock x:Name="ErrorTextBlock" Foreground="IndianRed" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset to defaults" Padding="10,4" Click="ResetDefaults_Click" />
            <Button Grid.Column="2" Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="3" Content="Save" Width="80" IsDefault="True" Click="Save_Click" />
        </Grid>
    </StackPanel>
</Window>
